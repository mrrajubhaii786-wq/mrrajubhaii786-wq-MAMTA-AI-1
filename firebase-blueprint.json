{
  "entities": {
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message exchanged in a chat session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "pageSource": { "type": "string" }
      },
      "required": ["id", "sessionId", "role", "content", "timestamp", "pageSource"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "A log entry of user actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "page": { "type": "string", "enum": ["home", "workspace", "admin", "safedrop"] },
        "userSession": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "page", "userSession", "details", "timestamp"]
    },
    "WikiEntry": {
      "title": "WikiEntry",
      "description": "An entry in the OpenWiki knowledge base",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "tags", "createdAt"]
    },
    "VaultItem": {
      "title": "VaultItem",
      "description": "An encrypted credential stored in the SafeDrop Vault",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "keyName": { "type": "string" },
        "encryptedValue": { "type": "string" },
        "itemType": { "type": "string", "enum": ["api_key", "password", "token", "secret", "note"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "keyName", "encryptedValue", "itemType", "createdAt"]
    },
    "Memory": {
      "title": "Memory",
      "description": "Cloud memory records of Mamta AI learning",
      "type": "object",
      "properties": {
        "input": { "type": "string" },
        "output": { "type": "string" },
        "time": { "type": "integer" }
      },
      "required": ["input", "output", "time"]
    },
    "SaaSUser": {
      "title": "SaaSUser",
      "description": "Multi-tenant user profile for the MAMTA AI SaaS Startup platform",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "plan": { "type": "string", "enum": ["FREE", "PRO", "PREMIUM"] },
        "limit": { "type": "integer" },
        "usage": { "type": "integer" },
        "credits": { "type": "integer" },
        "country": { "type": "string" },
        "verified": { "type": "boolean" }
      },
      "required": ["email", "plan", "limit", "usage", "credits", "country", "verified"]
    },
    "SaaSProject": {
      "title": "SaaSProject",
      "description": "User generated websites and landing pages",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "prompt": { "type": "string" },
        "html": { "type": "string" },
        "isDeployed": { "type": "boolean" },
        "subdomain": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["projectId", "userId", "prompt", "html", "isDeployed", "createdAt"]
    },
    "SaaSAnalytics": {
      "title": "SaaSAnalytics",
      "description": "Platform global event tracking metric log",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "metadata": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["userId", "action", "createdAt"]
    }
  },
  "firestore": {
    "/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "Collection of chat messages"
    },
    "/logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Collection of system and user logs"
    },
    "/wiki/{wikiId}": {
      "schema": "WikiEntry",
      "description": "Collection of Wiki knowledge base articles"
    },
    "/vault/{vaultId}": {
      "schema": "VaultItem",
      "description": "Collection of encrypted credentials"
    },
    "/memory/{memoryId}": {
      "schema": "Memory",
      "description": "Collection of learning memory records"
    },
    "/saas_users/{email}": {
      "schema": "SaaSUser",
      "description": "Multi-tenant SaaS startup users with tier limit configurations and payment settings"
    },
    "/saas_projects/{projectId}": {
      "schema": "SaaSProject",
      "description": "User generated SaaS landing pages and custom websites"
    },
    "/saas_analytics/{analyticsId}": {
      "schema": "SaaSAnalytics",
      "description": "Activity analytics log of platform-wide user operations and builds"
    }
  }
}
