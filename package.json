    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
